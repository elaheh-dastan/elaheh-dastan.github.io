---
import Divider from "../components/Divider.astro";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";
---
<Layout
	title="Education - Elaheh Dastan | M.Sc. in Artificial Intelligence"
	description="Educational background of Elaheh Dastan: M.Sc. in Artificial Intelligence and B.Sc. in Computer Engineering from Amirkabir University of Technology, Tehran, Iran."
>
	<section id="education" class="bgWhite ofsInBottom">
		<div class="expertise">
			<Title title="Education" />
			<div class="content">
				<div class="block-content">
					<div class="timeline education">
						<div class="row">
							<div class="col-md-12">
								<div class="exp-holder margTop">
									<div class="exp">
										<div class="hgroup">
											<h4>M.Sc. in Artificial Intelligence</h4>
											<h6><i class="fas fa-calendar" />2022 - 2024</h6>
											<h6>
												<i class="fas fa-flask" />Research focus: Deep Learning, Time
												Series Analysis, Intelligent Transportation Systems
											</h6>
											<h6>
												<i class="fas fa-thumbtack" />
												<b class="bold">
													<a class="gpacolor" href="https://aut.ac.ir/">
														Amirkabir University of Technology
													</a>
												</b>, Tehran, Iran
											</h6>
										</div>
										<br />
									</div>
									<div class="exp">
										<div class="hgroup">
											<h4>B.Sc. in Computer Engineering</h4>
											<h6><i class="fas fa-calendar" />2017 - 2022</h6>
											<h6>
												<i class="fas fa-book" />Relevant coursework: Machine Learning,
												Data Structures, Algorithms, Database Systems, Statistics
											</h6>
											<h6>
												<i class="fas fa-thumbtack" />
												<b class="bold">
													<a class="gpacolor" href="https://aut.ac.ir/">
														Amirkabir University of Technology
													</a>
												</b>, Tehran, Iran
											</h6>
										</div>
										<br />
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<Title title="Publications & Research" />
			<div class="content">
				<div class="block-content text-body">
					<div class="exp-holder">
						<div class="exp">
							<div class="hgroup">
								<h4>
									<a href="https://arxiv.org/abs/2309.09830">
										Deep ETA Prediction for Urban Transport Systems
									</a>
								</h4>
								<h6 class="text-muted">
									IEEE Intelligent Vehicles Symposium (IV), 2022 &mdash; Co-author
								</h6>
							</div>
							<ul>
								<li>
									Deep learning-based ETA prediction for ride-hailing services,
									combining spatial-temporal features with real-time traffic
									patterns.
								</li>
								<li>
									Achieved state-of-the-art performance on a large-scale urban
									transportation dataset.
								</li>
							</ul>
						</div>
					</div>
					<p>
						Publications are also listed on{" "}
						<a href="https://scholar.google.com/citations?user=1BxI0JkAAAAJ">
							Google Scholar
						</a>.
					</p>
				</div>
			</div>

			<div class="button margTop ofsInTop tCenter">
				<Divider />
			</div>
		</div>
	</section>
</Layout>
