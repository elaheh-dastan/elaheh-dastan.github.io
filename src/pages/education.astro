---
import Divider from "../components/Divider.astro";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";
---
<Layout
	title="Education - Elaheh Dastan | B.Sc. in Computer Engineering"
	description="Educational background of Elaheh Dastan: B.Sc. in Computer Engineering from Amirkabir University of Technology, Tehran, Iran."
>
	<section id="education" class="bgWhite ofsInBottom">
		<div class="expertise">
			<Title title="Education" />
			<div class="content">
				<div class="block-content">
					<div class="timeline education">
						<div class="row">
							<div class="col-md-12">
								<div class="exp-holder margTop">
									<div class="exp">
										<div class="hgroup">
											<h4>B.Sc. Computer Engineering</h4>
											<h6><i class="fas fa-calendar" />2017 - 2022</h6>
											<h6>
												<i class="fas fa-thumbtack" />
												<b class="bold">
													<a class="gpacolor" href="https://aut.ac.ir/">
														Amirkabir University of Technology
													</a>
												</b>, Tehran, Iran
											</h6>
										</div>
										<br />
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="button margTop ofsInTop tCenter">
				<Divider />
			</div>
		</div>
	</section>
</Layout>
