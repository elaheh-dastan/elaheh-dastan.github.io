---
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import { degrees, publications, university } from "../data/education";
import { profile } from "../data/profile";
import Layout from "../layouts/Layout.astro";
---
<Layout
	title="Education – Elaheh Dastan"
	description={`Education of Elaheh Dastan: ${degrees.map((d) => d.title).join(" and ")} from ${university.name}, ${university.location}, plus publications.`}
>
	<PageHeader
		eyebrow="Education"
		title="Degrees and research"
		lede={`Both of my degrees are from ${university.name} in ${university.location}, where my graduate research focused on deep learning for intelligent transportation systems.`}
	/>

	<section class="section" aria-labelledby="degrees">
		<h2 id="degrees" class="visually-hidden">Degrees</h2>
		<div class="timeline">
			{
				degrees.map((degree) => (
					<article class="entry">
						<div class="entry-head">
							<div>
								<h2>{degree.title}</h2>
								<p class="entry-descriptor">
									<a href={university.url} target="_blank" rel="noopener">{university.name}</a>
								</p>
							</div>
							<div class="entry-meta">
								<span>
									<Icon name="calendar" size={12} />
									{degree.date}
								</span>
								<span>
									<Icon name="location-dot" size={12} />
									{university.location}
								</span>
							</div>
						</div>
						<ul class="bullets">
							<li>
								<strong>{degree.detailLabel}:</strong> {degree.detail}
							</li>
						</ul>
					</article>
				))
			}
		</div>
	</section>

	<section class="section" aria-labelledby="publications">
		<div class="section-header">
			<div>
				<p class="eyebrow">Research</p>
				<h2 id="publications">Publications</h2>
			</div>
			<a class="section-link" href={profile.scholar} target="_blank" rel="noopener">
				Google Scholar
				<Icon name="arrow-up-right" size={12} />
			</a>
		</div>
		<div class="grid">
			{
				publications.map((paper) => (
					<article class="card">
						<div class="card-head">
							<h3>
								<a href={paper.url} target="_blank" rel="noopener">{paper.title}</a>
							</h3>
							<span class="muted small">{paper.year}</span>
						</div>
						<p class="muted small">
							{paper.role} · {paper.venue} · {paper.id}
						</p>
						<p>{paper.summary}</p>
					</article>
				))
			}
		</div>
	</section>
</Layout>
