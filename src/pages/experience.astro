---
import Chips from "../components/Chips.astro";
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import { experience } from "../data/experience";
import Layout from "../layouts/Layout.astro";

const employers = experience.map((e) => e.name).join(", ");
---
<Layout
	title="Experience – Elaheh Dastan"
	description={`Work history of Elaheh Dastan, Senior Machine Learning Engineer: ${employers}.`}
>
	<PageHeader
		eyebrow="Experience"
		title="Work history"
		lede="Nine years of machine learning work across industrial AI, e-commerce search, fintech forecasting, and ride-hailing ETA, from research prototypes to systems serving millions of users."
	/>

	<div class="timeline">
		{
			experience.map((employer) => (
				<article class="entry">
					<div class="entry-head">
						<div>
							<h2>{employer.name}</h2>
							{employer.descriptor && <p class="entry-descriptor">{employer.descriptor}</p>}
						</div>
						<div class="entry-meta">
							<span>
								<Icon name="location-dot" size={12} />
								{employer.location}
							</span>
						</div>
					</div>
					{employer.roles.map((role) => (
						<div class="role">
							<div class="role-head">
								<h3>{role.title}</h3>
								<span class="role-date">{role.date}</span>
							</div>
							<ul class="bullets">
								{role.bullets.map((bullet) => (
									<li>{bullet}</li>
								))}
							</ul>
							<Chips items={role.tags} outline label="Technologies" />
						</div>
					))}
				</article>
			))
		}
	</div>
</Layout>
