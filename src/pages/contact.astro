---
import Icon, { type IconName } from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import { profile } from "../data/profile";
import Layout from "../layouts/Layout.astro";

const channels: {
	icon: IconName;
	label: string;
	value: string;
	href: string;
	external?: boolean;
}[] = [
	{
		icon: "envelope",
		label: "Email",
		value: profile.email,
		href: `mailto:${profile.email}`,
	},
	{
		icon: "phone",
		label: "Phone",
		value: profile.phone,
		href: profile.phoneHref,
	},
	{
		icon: "linkedin",
		label: "LinkedIn",
		value: "linkedin.com/in/elaheh-dastan",
		href: profile.linkedin,
		external: true,
	},
	{
		icon: "github",
		label: "GitHub",
		value: "github.com/elaheh-dastan",
		href: profile.github,
		external: true,
	},
	{
		icon: "google-scholar",
		label: "Google Scholar",
		value: "Publications and citations",
		href: profile.scholar,
		external: true,
	},
	{
		icon: "medium",
		label: "Medium",
		value: "elahe-dstn.medium.com",
		href: profile.medium,
		external: true,
	},
	{
		icon: "instagram",
		label: "Instagram",
		value: "@elahe.dstn",
		href: profile.instagram,
		external: true,
	},
	{
		icon: "key",
		label: "Public keys",
		value: "SSH keys on GitHub",
		href: profile.githubKeys,
		external: true,
	},
];
---
<Layout
	title="Contact – Elaheh Dastan"
	description="Get in touch with Elaheh Dastan by email, phone, LinkedIn, GitHub, Medium, or Google Scholar."
>
	<PageHeader
		eyebrow="Contact"
		title="Get in touch"
		lede={`I am based in ${profile.location} and happy to talk about machine learning roles, LLM evaluation, or collaboration on open-source work. Email is the fastest way to reach me.`}
	/>

	<div class="contact-grid">
		{
			channels.map((c) => (
				<a
					class="contact-card"
					href={c.href}
					target={c.external ? "_blank" : undefined}
					rel={c.external ? "me noopener" : undefined}
				>
					<span class="contact-icon">
						<Icon name={c.icon} size={18} />
					</span>
					<span>
						<strong>{c.label}</strong>
						<span class="small">{c.value}</span>
					</span>
				</a>
			))
		}
	</div>
</Layout>
