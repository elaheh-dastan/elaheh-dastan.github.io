---
import Divider from "../components/Divider.astro";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";
---
<Layout
	title="Contact - Elaheh Dastan"
	description="Get in touch with Elaheh Dastan by email, LinkedIn, GitHub, Medium, or Google Scholar."
>
	<section id="contact" class="bgWhite ofsInBottom">
		<div class="contact">
			<Title title="Contact Me" />
			<div class="content">
				<div class="block-content margBSmall">
					<div class="row">
						<div class="col-md-8 text-body">
							<b class="fw-bold"><i class="fab fa-google" /> Email</b>:&nbsp;
							elahe.dstn <b class="fw-bold">at</b> gmail <b class="fw-bold">dot</b> com
							<br />
							<b class="fw-bold"><i class="fas fa-phone" /> Phone</b>:&nbsp;
							<a href="tel:+447810170938" class="text-muted">(+44) 7810 170938</a>
							<br />
							<b class="fw-bold"><i class="fab fa-linkedin" /> LinkedIn</b>:&nbsp;
							<a
								href="https://www.linkedin.com/in/elaheh-dastan/"
								target="_blank"
								rel="noopener"
							>
								elaheh-dastan
							</a>
							<br />
							<b class="fw-bold"><i class="fab fa-github" /> GitHub</b>:&nbsp;
							<a href="https://github.com/elaheh-dastan" target="_blank" rel="noopener">
								elaheh-dastan
							</a>
							<br />
							<b class="fw-bold"><i class="fab fa-medium" /> Medium</b>:&nbsp;
							<a href="https://elahe-dstn.medium.com" target="_blank" rel="noopener">
								elahe-dstn
							</a>
							<br />
							<b class="fw-bold"
								><i class="fas fa-graduation-cap" /> Google Scholar</b
							>:&nbsp;
							<a
								href="https://scholar.google.com/citations?user=1BxI0JkAAAAJ"
								target="_blank"
								rel="noopener"
							>
								profile
							</a>
							<Divider />
						</div>
						<div class="col-md-4">
							<a
								href="https://github.com/elaheh-dastan.keys"
								target="_blank"
								role="button"
								rel="noopener"
								class="btn btn-outline-dark"
							>
								Public Keys
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
