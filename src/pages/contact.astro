---
import Divider from "../components/Divider.astro";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";
---
<Layout
	title="Contact - Elaheh Dastan"
	description="Get in touch with Elaheh Dastan by email, phone, or Skype."
>
	<section id="contact" class="bgWhite ofsInBottom">
		<div class="contact">
			<Title title="Contact Me" />
			<div class="content">
				<div class="block-content margBSmall">
					<div class="row">
						<div class="col-md-8 text-body">
							<b class="fw-bold"><i class="fab fa-google" /> Email</b>:&nbsp;
							elaheh.dstn <b class="fw-bold">at</b> gmail <b class="fw-bold">dot</b> com
							<br />
							<b class="fw-bold"><i class="fas fa-university" /> Email</b>:&nbsp;
							dastan.elaheh <b class="fw-bold">at</b> aut <b class="fw-bold">dot</b> ac
							<b class="fw-bold">dot</b> ir
							<br />
							<b class="fw-bold"><i class="fab fa-skype" /> Skype</b>:&nbsp; elaheh.dstn
							<br />
							<b class="fw-bold"><i class="fas fa-phone" /> Phone</b>:&nbsp;
							<a href="tel:+989352257378" class="text-muted">(+98) 935 225 73 78</a>
							<Divider />
						</div>
						<div class="col-md-4">
							<a
								href="https://github.com/elaheh-dastan.keys"
								target="_blank"
								role="button"
								rel="noopener"
								class="btn btn-outline-dark"
							>
								Public Keys
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
