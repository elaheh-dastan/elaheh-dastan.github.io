---
import Chips from "../components/Chips.astro";
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import { projects } from "../data/projects";
import Layout from "../layouts/Layout.astro";
---
<Layout
	title="Projects – Elaheh Dastan"
	description="Open-source projects by Elaheh Dastan: agentic text-to-SQL, LLM tool-using agents, multi-agent applications, and LLM-as-judge services."
>
	<PageHeader
		eyebrow="Projects"
		title="Open source"
		lede="Small, complete systems I built to explore agentic LLM patterns end to end: tool calling, handoffs and guardrails, LLM-as-judge evaluation, and vector search."
	/>

	<div class="grid grid-2">
		{
			projects.map((project) => (
				<article class="card">
					<div class="card-head">
						<h3>{project.title}</h3>
						<span class="muted small">{project.year}</span>
					</div>
					<p class="muted small">{project.tagline}</p>
					<p>{project.description}</p>
					<div class="card-foot">
						<Chips items={project.tags} outline label="Technologies" />
						<a
							class="card-link"
							href={`https://github.com/${project.repo}`}
							target="_blank"
							rel="noopener"
						>
							<Icon name="github" size={14} />
							{project.repo.split("/")[1]}
						</a>
					</div>
				</article>
			))
		}
	</div>
</Layout>
