---
import { Image } from "astro:assets";
import portrait from "../assets/elaheh-dastan.jpg";
import Chips from "../components/Chips.astro";
import Icon from "../components/Icon.astro";
import { experience } from "../data/experience";
import {
	interests,
	languages,
	profile,
	skills,
	summary,
} from "../data/profile";
import Layout from "../layouts/Layout.astro";

// The resume repo publishes the default variant as `elaheh.pdf` on every
// release purely so this link keeps resolving; see CLAUDE.md.
let resumeTag = "latest";
try {
	const res = await fetch(
		`https://api.github.com/repos/${profile.resumeRepo}/releases/latest`,
	);
	if (!res.ok) {
		throw new Error(`GitHub API returned ${res.status}`);
	}
	const latest = await res.json();
	resumeTag = latest.tag_name || "latest";
} catch (error) {
	console.error("Failed to fetch resume tag:", error);
}
const resumeUrl = `https://github.com/${profile.resumeRepo}/releases/download/${resumeTag}/elaheh.pdf`;

const current = experience[0];
const currentRole = current.roles[0];
---
<Layout>
	<section class="hero" aria-labelledby="intro">
		<div class="hero-text">
			<p class="eyebrow">{profile.headline}</p>
			<h1 id="intro">{profile.name}</h1>
			<p class="lede">{profile.tagline}</p>
			<p class="hero-location">
				<Icon name="location-dot" size={14} />
				{profile.location} · Open to remote work
			</p>
			<div class="hero-actions">
				<a class="btn btn-primary" href={resumeUrl} target="_blank" rel="noreferrer">
					<Icon name="file-arrow-down" size={15} />
					Download CV
					{resumeTag !== "latest" && <small>({resumeTag})</small>}
				</a>
				<a class="btn" href={profile.linkedin} target="_blank" rel="noopener">
					<Icon name="linkedin" size={15} />
					LinkedIn
				</a>
				<a class="btn" href={profile.github} target="_blank" rel="noopener">
					<Icon name="github" size={15} />
					GitHub
				</a>
				<a class="btn" href={`mailto:${profile.email}`}>
					<Icon name="envelope" size={15} />
					Email
				</a>
			</div>
		</div>
		<figure class="hero-figure">
			<Image
				src={portrait}
				alt="Elaheh Dastan standing in front of the Louvre pyramid in Paris"
				widths={[360, 560, 848]}
				sizes="(min-width: 56rem) 22rem, 18rem"
				class="hero-photo"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>
	</section>

	<section class="section" aria-label="At a glance">
		<ul class="facts">
			<li class="fact">
				<strong>{profile.years} years</strong>
				<span>building and shipping ML systems</span>
			</li>
			<li class="fact">
				<strong>{current.name}</strong>
				<span>{currentRole.title}, {current.descriptor}</span>
			</li>
			<li class="fact">
				<strong>M.Sc. in AI</strong>
				<span>Amirkabir University of Technology</span>
			</li>
			<li class="fact">
				<strong>LLM evaluation</strong>
				<span>RAG, agents, and LLM-as-judge in production</span>
			</li>
		</ul>
	</section>

	<section class="section about-grid" aria-labelledby="about">
		<div>
			<div class="section-header">
				<div>
					<p class="eyebrow">About</p>
					<h2 id="about">Who I am</h2>
				</div>
			</div>
			<div class="prose">
				{summary.map((paragraph) => <p>{paragraph}</p>)}
				<p>
					I believe open source is holy. The people who could charge for their
					research or their code but publish it for free are the ones who move
					the whole field forward.
				</p>
			</div>
		</div>
		<aside>
			<div class="aside-block">
				<h3>Interests</h3>
				<Chips items={interests} label="Interests" />
			</div>
			<div class="aside-block">
				<h3>Languages</h3>
				<Chips items={languages.map((l) => `${l.name} · ${l.level}`)} outline label="Languages" />
			</div>
		</aside>
	</section>

	<section class="section" aria-labelledby="skills">
		<div class="section-header">
			<div>
				<p class="eyebrow">Skills</p>
				<h2 id="skills">What I work with</h2>
			</div>
		</div>
		<dl class="skills">
			{
				skills.map((group) => (
					<div class="skill-row">
						<dt>{group.group}</dt>
						<dd>
							<Chips items={group.items} outline label={group.group} />
						</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="section" aria-labelledby="where">
		<div class="section-header">
			<div>
				<p class="eyebrow">Experience</p>
				<h2 id="where">Where I have worked</h2>
			</div>
			<a class="section-link" href="/experience">
				Full work history
				<Icon name="arrow-up-right" size={12} />
			</a>
		</div>
		<ol class="roles">
			{
				experience.map((employer) => (
					<li>
						<div>
							<div class="role-employer">
								{employer.name}
								{employer.descriptor && (
									<span class="muted small"> · {employer.descriptor}</span>
								)}
							</div>
							<div class="role-title">
								{[...employer.roles].reverse().map((r) => r.title).join(" → ")}
							</div>
						</div>
						<div class="role-date">
							{employer.roles.length === 1
								? employer.roles[0].date
								: `${employer.roles[employer.roles.length - 1].date.split(" – ")[0]} – ${employer.roles[0].date.split(" – ")[1]}`}
						</div>
					</li>
				))
			}
		</ol>
	</section>
</Layout>
