---
import { Image } from "astro:assets";
import dataScientist from "../assets/elaheh-dastan-data-scientist.jpg";
import Title from "../components/Title.astro";
import Layout from "../layouts/Layout.astro";

let resumeTag = "latest";
try {
	const res = await fetch(
		"https://api.github.com/repos/elaheh-dastan/elaheh-dastan.pdf/releases/latest",
	);
	if (!res.ok) {
		throw new Error(`GitHub API returned ${res.status}`);
	}
	const latest = await res.json();
	resumeTag = latest.tag_name || "latest";
} catch (error) {
	console.error("Failed to fetch resume tag:", error);
}
---
<Layout>
	<section id="about" class="bgWhite ofsInBottom">
		<div class="about">
			<Title title="Who am I?" />
			<div class="content">
				<div class="block-content margBSmall">
					<div class="profile margBSmall">
						<h1>Elaheh Dastan</h1>
						<h3>Senior Machine Learning Engineer & Data Scientist</h3>
						<h6 class="text-muted">Barcelona, Spain</h6>
					</div>
					<div class="row">
						<div class="col-md-8 text-body">
							<p>
								Senior ML engineer with 7+ years of experience designing and
								deploying scalable machine learning systems and data pipelines. I
								build end-to-end solutions, from data collection and ETL to model
								training and production deployment.
							</p>
							<br />
							<p>
								I have delivered data-driven products with measurable business
								impact across e-commerce, fintech, and transportation — search and
								retrieval systems at Digikala, forecasting and portfolio models at
								Asan Pardakht, and ETA and traffic prediction at Snapp!.
							</p>
							<br />
							<p>
								I studied computer engineering at Amirkabir University of
								Technology and went on to an M.Sc. in Artificial Intelligence
								there, with published research in intelligent transportation
								systems. Lately most of my work sits around LLMs, agentic systems,
								and the LLMOps practices that keep them honest in production.
							</p>
							<br />
							<p>
								I believe open source is holy, and that the people who could charge
								for their research or their code but publish it for free are the
								ones who will go to heaven.
							</p>
							<br />
							<Image
								src={dataScientist}
								alt="Elaheh Dastan"
								class="img-fluid rounded"
							/>
						</div>
						<div class="col-md-4">
							<b class="fw-bold fs-5">Interests:</b>
							<ul class="bullet">
								<li>LLMs & Agentic AI</li>
								<li>Retrieval & Recommendation</li>
								<li>Time Series Forecasting</li>
								<li>MLOps & LLMOps</li>
								<li>Intelligent Transportation</li>
							</ul>
							<hr />
							<b class="fw-bold fs-5">Key Skills:</b>
							<ul class="bullet">
								<li>Python, Go, PyTorch, TensorFlow</li>
								<li>Pydantic AI, LangChain, LangGraph</li>
								<li>RAG & Vector Databases</li>
								<li>Airflow, Spark, MLflow, Kubeflow</li>
								<li>Docker, Kubernetes, AWS, GCP</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-6 mx-auto">
					<a
						target="_blank"
						rel="noreferrer"
						href={`https://github.com/elaheh-dastan/elaheh-dastan.pdf/releases/download/${resumeTag}/main.pdf`}
						class="but opc-2"
					>
						<i class="fas fa-paperclip" /> Here is my CV (updated at {resumeTag})
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
