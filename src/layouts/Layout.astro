---
import { Image } from "astro:assets";
import "@fontsource-variable/inter";
import "../styles/global.css";
import avatar from "../assets/elaheh-dastan-avatar.jpg";
import ogImage from "../assets/elaheh-dastan-og.jpg";
import Icon, { type IconName } from "../components/Icon.astro";
import { profile } from "../data/profile";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${profile.name} – ${profile.headline}`,
	description = `${profile.headline} with ${profile.years} years of experience designing and deploying scalable machine learning systems and data pipelines across e-commerce, fintech, transportation, and industrial AI.`,
} = Astro.props;

const { pathname } = Astro.url;
const canonical = new URL(pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage.src, Astro.site).href;

// Drop the trailing slash Astro emits for directory routes so nav links match
// regardless of the `trailingSlash` setting.
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "");

const nav: { href: string; icon: IconName; label: string }[] = [
	{ href: "/", icon: "user", label: "About" },
	{ href: "/experience", icon: "briefcase", label: "Experience" },
	{ href: "/projects", icon: "diagram-project", label: "Projects" },
	{ href: "/education", icon: "graduation-cap", label: "Education" },
	{ href: "/contact", icon: "envelope", label: "Contact" },
];

const socials: { href: string; icon: IconName; label: string }[] = [
	{ href: profile.github, icon: "github", label: "GitHub" },
	{ href: profile.linkedin, icon: "linkedin", label: "LinkedIn" },
	{ href: profile.scholar, icon: "google-scholar", label: "Google Scholar" },
	{ href: profile.medium, icon: "medium", label: "Medium" },
	{ href: profile.instagram, icon: "instagram", label: "Instagram" },
];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: profile.name,
	jobTitle: profile.headline,
	description,
	url: profile.site,
	image: ogImageUrl,
	email: profile.email,
	telephone: profile.phone,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Barcelona",
		addressCountry: "ES",
	},
	worksFor: { "@type": "Organization", name: "Caterpillar" },
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "Amirkabir University of Technology",
	},
	sameAs: [
		profile.github,
		profile.linkedin,
		profile.scholar,
		profile.medium,
		profile.instagram,
	],
	knowsAbout: [
		"Machine Learning",
		"Deep Learning",
		"Large Language Models",
		"LLM Evaluation",
		"Agentic AI",
		"Information Retrieval",
		"Recommendation Systems",
		"Time Series Forecasting",
		"MLOps",
		"Python",
		"Go",
	],
};

const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e1520" media="(prefers-color-scheme: dark)" />
		<meta name="robots" content="index, follow" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={profile.name} />

		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />

		<meta property="og:type" content="profile" />
		<meta property="og:site_name" content={profile.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content={String(ogImage.width)} />
		<meta property="og:image:height" content={String(ogImage.height)} />
		<meta property="og:image:alt" content={`${profile.name}, ${profile.headline}`} />
		<meta property="profile:first_name" content="Elaheh" />
		<meta property="profile:last_name" content="Dastan" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="container site-header-inner">
				<a href="/" class="brand">
					<Image
						src={avatar}
						alt=""
						width={72}
						height={72}
						class="brand-avatar"
						loading="eager"
					/>
					<span>{profile.name}</span>
				</a>
				<nav class="site-nav" aria-label="Main">
					{
						nav.map((item) => (
							<a
								href={item.href}
								aria-current={currentPath === item.href ? "page" : undefined}
							>
								<Icon name={item.icon} size={14} />
								{item.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main id="main" class="container">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container site-footer-inner">
				<p>
					© {year} {profile.name} · {profile.location} ·{" "}
					<a href={`mailto:${profile.email}`}>{profile.email}</a>
				</p>
				<ul class="social" aria-label="Profiles">
					{
						socials.map((s) => (
							<li>
								<a href={s.href} target="_blank" rel="me noopener" aria-label={s.label} title={s.label}>
									<Icon name={s.icon} size={16} />
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</footer>
	</body>
</html>
