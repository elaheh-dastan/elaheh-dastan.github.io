---
import { Image } from "astro:assets";
import profile from "../assets/elaheh-dastan-profile.jpg";
import "bootstrap/dist/css/bootstrap.css";
import "@fortawesome/fontawesome-free/css/all.min.css";
import "../styles/base.css";
import "../styles/main.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Elaheh Dastan - Senior Machine Learning Engineer & Data Scientist",
	description = "Senior ML engineer with 7+ years of experience designing and deploying scalable machine learning systems and data pipelines across e-commerce, fintech, and transportation.",
} = Astro.props;

const { pathname } = Astro.url;
const canonical = new URL(pathname, Astro.site).href;

// Normalize the current path (drop the trailing slash Astro emits for
// directory routes) so nav links match regardless of `trailingSlash` config.
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "");

const nav = [
	{ href: "/", icon: "fa-user", label: "About Me" },
	{ href: "/experience", icon: "fa-briefcase", label: "Work" },
	{ href: "/projects", icon: "fa-diagram-project", label: "Projects" },
	{ href: "/education", icon: "fa-graduation-cap", label: "Education" },
	{ href: "/lecture", icon: "fa-book", label: "Lectures" },
	{ href: "/contact", icon: "fa-pen", label: "Contact" },
];

const socials = [
	{
		href: "https://github.com/elaheh-dastan",
		icon: "fa-github",
		label: "Github",
	},
	{
		href: "https://www.linkedin.com/in/elaheh-dastan/",
		icon: "fa-linkedin",
		label: "LinkedIn",
	},
	{
		href: "https://elahe-dstn.medium.com",
		icon: "fa-medium",
		label: "Medium",
	},
	{
		href: "https://www.instagram.com/elahe.dstn",
		icon: "fa-instagram",
		label: "Instagram",
	},
];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Elaheh Dastan",
	jobTitle: "Senior Machine Learning Engineer",
	description:
		"Senior ML engineer with 7+ years of experience designing and deploying scalable machine learning systems and data pipelines.",
	url: "https://elaheh-dastan.github.io",
	email: "elahe.dstn@gmail.com",
	telephone: "+44 7810 170938",
	sameAs: [
		"https://github.com/elaheh-dastan",
		"https://www.linkedin.com/in/elaheh-dastan/",
		"https://scholar.google.com/citations?user=1BxI0JkAAAAJ",
		"https://elahe-dstn.medium.com",
		"https://www.instagram.com/elahe.dstn",
	],
	alumniOf: {
		"@type": "CollegeOrUniversity",
		name: "Amirkabir University of Technology",
	},
	knowsAbout: [
		"Machine Learning",
		"Deep Learning",
		"Large Language Models",
		"Agentic AI",
		"Recommendation Systems",
		"Time Series Forecasting",
		"MLOps",
		"Python",
		"Go",
	],
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Elaheh Dastan" />
		<meta
			name="keywords"
			content="Elaheh Dastan, Senior Machine Learning Engineer, Data Scientist, LLM Engineer, Agentic AI, MLOps, Python, PyTorch, Digikala, Snapp, Amirkabir University of Technology"
		/>

		<link rel="canonical" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Elaheh Dastan" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(profile.src, Astro.site).href} />
		<meta property="og:image:alt" content="Elaheh Dastan - Machine Learning Engineer" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(profile.src, Astro.site).href} />

		<!-- JSON-LD Structured Data -->
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(jsonLd)}
		/>

		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌰</text></svg>"
		/>
	</head>
	<body>
		<div class="margLTop margLBottom">
			<div class="container">
				<div class="row">
					<div class="col-md-3 left-content">
						<header id="header">
							<div class="main-header">
								<figure class="img-profile">
									<Image
										src={profile}
										alt="Elaheh Dastan"
										width={1024}
										height={1024}
										loading="eager"
										fetchpriority="high"
									/>
									<figcaption class="name-profile">
										<span>ELAHEH DASTAN</span>
									</figcaption>
								</figure>
								<nav class="main-nav">
									<ul>
										{
											nav.map((item) => (
												<li class="nav-item">
													<a
														href={item.href}
														class:list={["nav-link", { active: currentPath === item.href }]}
													>
														<i class={`fas ${item.icon}`} />
														{item.label}
													</a>
												</li>
											))
										}
									</ul>
								</nav>
							</div>
							<div class="bottom-header bgWhite ofsTSmall ofsBSmall tCenter">
								<ul class="social">
									{
										socials.map((s) => (
											<li class="anim">
												<a href={s.href} target="_blank" rel="me noopener" aria-label={s.label}>
													<i class={`fab ${s.icon}`} />
												</a>
											</li>
										))
									}
								</ul>
								<p></p>
							</div>
						</header>
					</div>
					<main id="main" class="col-md-7 right-content">
						<slot />
					</main>
					<div class="col-md-2">
						<aside class="contact-sidebar sticky-top pt-4">
							<div class="sidebar-title">
								<h5>Contact Me</h5>
								<div class="divider">
									<div data-svg-drawing="yes" class="zigzag large clearfix">
										<svg
											aria-hidden="true"
											xml:space="preserve"
											viewBox="0 0 69.172 14.975"
											width="37"
											height="28"
											y="0px"
											x="0px"
											version="1.1"
											xmlns="http://www.w3.org/2000/svg"
											xmlns:xlink="http://www.w3.org/1999/xlink"
										>
											<path
												d="M1.357,12.26 10.807,2.81 20.328,12.332 29.781,2.879 39.223,12.321 48.754,2.79 58.286,12.321 67.815,2.793"
												style="stroke-dasharray: 93.9851, 93.9851; stroke-dashoffset: 0;"
											></path>
										</svg>
									</div>
								</div>
							</div>
							<ul class="contact-list">
								<li>
									<a href="mailto:elahe.dstn@gmail.com">
										<i class="fab fa-google" /><span>Email</span>
									</a>
								</li>
								<li>
									<a
										href="https://www.linkedin.com/in/elaheh-dastan/"
										target="_blank"
										rel="noopener"
									>
										<i class="fab fa-linkedin" /><span>LinkedIn</span>
									</a>
								</li>
								<li>
									<a href="tel:+447810170938">
										<i class="fas fa-phone" /><span>Phone</span>
									</a>
								</li>
								<li>
									<a
										href="https://scholar.google.com/citations?user=1BxI0JkAAAAJ"
										target="_blank"
										rel="noopener"
									>
										<i class="fas fa-graduation-cap" /><span>Scholar</span>
									</a>
								</li>
								<li>
									<a href="https://github.com/elaheh-dastan.keys" target="_blank" rel="noopener">
										<i class="fas fa-key" /><span>Public Keys</span>
									</a>
								</li>
							</ul>
							<a
								href="https://github.com/elaheh-dastan"
								target="_blank"
								rel="noopener"
								class="github-follow-btn"
							>
								<i class="fab fa-github" /><span>Follow me on GitHub</span>
							</a>
						</aside>
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
